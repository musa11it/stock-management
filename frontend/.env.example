# Only needed when the frontend and backend are deployed as separate origins (e.g. two Vercel
# projects). Leave unset for local dev - vite.config.ts already proxies /api to the backend.
# Baked in at build time, so set it before building/deploying, not just at runtime.
# Include the API prefix (matches the backend's API_PREFIX, /api/v1 by default):
VITE_API_URL=https://your-backend.vercel.app/api/v1
