# Server
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Database (docker-compose defaults)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/restaurant_stock?schema=public"

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d

# Seed / development super admin credentials
SEED_SUPER_ADMIN_EMAIL=admin@restaurant.com
SEED_SUPER_ADMIN_PASSWORD=Admin@12345
SEED_MANAGER_EMAIL=manager@restaurant.com
SEED_MANAGER_PASSWORD=Manager@12345
SEED_STAFF_EMAIL=staff@restaurant.com
SEED_STAFF_PASSWORD=Staff@12345

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
