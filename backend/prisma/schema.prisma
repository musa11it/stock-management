// Restaurant Stock Management System - Database Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================================================
// AUTH / RBAC
// ==========================================================================

enum RoleName {
  SUPER_ADMIN
  MANAGER
  STAFF
  RETAIL_USER
}

model Role {
  id          String           @id @default(uuid())
  name        RoleName         @unique
  description String?
  isSystem    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique // e.g. "products.read"
  module      String // e.g. "products"
  action      String // e.g. "read"
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id                String     @id @default(uuid())
  firstName         String
  lastName          String
  email             String     @unique
  phone             String?
  passwordHash      String
  roleId            String
  status            UserStatus @default(ACTIVE)
  managerId         String? // for staff assigned to a manager
  lastLoginAt       DateTime?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  role              Role       @relation(fields: [roleId], references: [id])
  manager           User?      @relation("ManagerStaff", fields: [managerId], references: [id])
  staff             User[]     @relation("ManagerStaff")

  purchasesCreated  Purchase[]        @relation("PurchaseCreatedBy")
  wastagesCreated   Wastage[]         @relation("WastageCreatedBy")
  wastagesApproved  Wastage[]         @relation("WastageApprovedBy")
  stockMovements    StockMovement[]   @relation("StockMovementCreatedBy")
  stockAdjustments  StockAdjustment[] @relation("StockAdjustmentCreatedBy")
  sales             Sale[]            @relation("SaleCreatedBy")
  salesConfirmed    Sale[]            @relation("SaleConfirmedBy")
  ordersPlaced      Sale[]            @relation("SaleCustomer")
  expensesCreated   Expense[]         @relation("ExpenseCreatedBy")
  expensesReceived  Expense[]         @relation("ExpenseRecipient")
  productionsCreated Production[]     @relation("ProductionCreatedBy")
  auditLogs         AuditLog[]
  notifications     Notification[]

  @@index([roleId])
  @@index([managerId])
  @@map("users")
}

// ==========================================================================
// CATALOG
// ==========================================================================

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("categories")
}

model Unit {
  id           String    @id @default(uuid())
  name         String    @unique // e.g. Kilogram
  abbreviation String    @unique // e.g. KG
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  products     Product[]

  @@map("units")
}

// An inventory/ingredient item (e.g. Rice, Beef, Cooking Oil) used to stock the kitchen and
// cost recipes - never sold directly. `id` is the system identifier used everywhere in code
// and relations; `name` is the human-facing unique key (restaurants don't stock two ingredients
// with the same name), replacing SKU/barcode which this restaurant has no use for.
// How a Product participates in the business's inventory/sales flow. Nullable and unenforced
// on old rows on purpose - existing products predate this classification and must not be
// guessed at automatically (see migration notes); once set, Production's dropdowns and
// validation key off it. PACKAGING is reserved for a future workflow, not used yet.
enum ProductType {
  RAW_MATERIAL
  FINISHED_PRODUCT
  DIRECT_SALE
  PACKAGING
}

model Product {
  id              String       @id @default(uuid())
  name            String       @unique
  description     String?
  categoryId      String
  unitId          String
  // Nullable: a product created before this field existed simply isn't classified yet - it
  // stays fully usable everywhere (purchases, sales, recipes) and just won't appear in
  // Production's type-filtered dropdowns until someone classifies it from the product form.
  type            ProductType?
  minimumStock    Decimal      @default(0) @db.Decimal(14, 3)
  maximumStock    Decimal?     @db.Decimal(14, 3)
  costPrice       Decimal      @default(0) @db.Decimal(14, 2)
  // Optional: most ingredients aren't sold directly, but a few (e.g. bottled drinks) are -
  // left unset (null), a product simply isn't offered for direct sale.
  sellingPrice    Decimal?     @db.Decimal(14, 2)
  isPerishable    Boolean      @default(false)
  shelfLifeDays   Int?
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  category        Category  @relation(fields: [categoryId], references: [id])
  unit            Unit      @relation(fields: [unitId], references: [id])

  inventories       Inventory[]
  inventoryBatches  InventoryBatch[]
  stockMovements    StockMovement[]
  purchaseItems     PurchaseItem[]
  stockAdjustments  StockAdjustment[]
  wastageItems      WastageItem[]
  recipeIngredients RecipeIngredient[]
  producedBy        Production[]         @relation("ProductionOutput")
  usedInProduction  ProductionMaterial[] @relation("ProductionMaterialProduct")
  // A Production-facing recipe attached directly to the finished product it produces (distinct
  // from Recipe.menuItemId, which attaches a recipe to a sellable menu item instead).
  productionRecipe   Recipe?             @relation("ProductFinishedRecipe")
  // The "List for Sale" menu wrapper for this product, if one has been created - see
  // MenuItem.linkedProductId.
  directSaleMenuItem MenuItem?           @relation("ProductDirectSaleMenuItem")

  @@index([categoryId])
  @@index([unitId])
  @@index([isActive])
  @@index([type])
  @@map("products")
}

// ==========================================================================
// WAREHOUSE / INVENTORY
// ==========================================================================

model Warehouse {
  id          String   @id @default(uuid())
  name        String   @unique
  location    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inventories      Inventory[]
  inventoryBatches InventoryBatch[]
  stockMovements   StockMovement[]
  purchases        Purchase[]
  stockAdjustments StockAdjustment[]
  wastages         Wastage[]
  sales            Sale[]
  productionsFrom  Production[] @relation("ProductionSource")
  productionsInto  Production[] @relation("ProductionDestination")
  productionMaterialsFrom ProductionMaterial[]

  @@map("warehouses")
}

// Aggregate stock level per product/warehouse - total quantity and running weighted-average
// cost. Expiry is NOT tracked here: the same product can be received on different dates with
// different expiry dates, so per-batch detail lives in InventoryBatch instead.
model Inventory {
  id             String   @id @default(uuid())
  productId      String
  warehouseId    String
  quantity       Decimal  @default(0) @db.Decimal(14, 3)
  reservedQty    Decimal  @default(0) @db.Decimal(14, 3)
  averageCost    Decimal  @default(0) @db.Decimal(14, 4)
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  product        Product   @relation(fields: [productId], references: [id])
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId])
  @@index([warehouseId])
  @@map("inventories")
}

// One row per receipt/batch of stock for a product at a warehouse, so each can carry its own
// expiry date (Expiry Date = Received Date + Product.shelfLifeDays, computed when stock is
// received - never stored on Product or entered by hand). `quantity` is what's left of that
// batch after FEFO consumption; it never goes below 0. Non-perishable products, and stock
// received before this feature existed, simply have expiryDate = null.
model InventoryBatch {
  id           String    @id @default(uuid())
  productId    String
  warehouseId  String
  quantity     Decimal   @db.Decimal(14, 3)
  unitCost     Decimal   @db.Decimal(14, 4)
  receivedDate DateTime  @default(now())
  expiryDate   DateTime?
  batchNumber  String?
  createdAt    DateTime  @default(now())

  product      Product   @relation(fields: [productId], references: [id])
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([productId, warehouseId, quantity])
  @@index([expiryDate])
  @@map("inventory_batches")
}

enum StockMovementType {
  PURCHASE
  CONSUMPTION
  WASTAGE
  SALE
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
  // Raw material consumed by / finished product yielded from a Production run. Kept distinct
  // from CONSUMPTION and ADJUSTMENT so existing reports (Net Profit's consumptionCost/
  // adjustmentGainValue) never see them - a production run moves value from raw-material stock
  // into finished-product stock, it doesn't create a loss or a stock-count correction.
  PRODUCTION_CONSUME
  PRODUCTION_YIELD
}

enum ReferenceType {
  PURCHASE
  WASTAGE
  SALE
  ADJUSTMENT
  CONSUMPTION
  TRANSFER
  RECIPE
  PRODUCTION
}

model StockMovement {
  id               String            @id @default(uuid())
  productId        String
  warehouseId      String
  type             StockMovementType
  quantity         Decimal           @db.Decimal(14, 3) // signed: positive = in, negative = out
  unitCost         Decimal?          @db.Decimal(14, 4)
  previousQuantity Decimal           @db.Decimal(14, 3)
  newQuantity      Decimal           @db.Decimal(14, 3)
  referenceType    ReferenceType?
  referenceId      String?
  reason           String?
  createdById      String
  createdAt        DateTime          @default(now())

  product          Product   @relation(fields: [productId], references: [id])
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id])
  createdBy        User      @relation("StockMovementCreatedBy", fields: [createdById], references: [id])

  @@index([productId])
  @@index([warehouseId])
  @@index([type])
  @@index([referenceType, referenceId])
  @@index([createdAt])
  @@map("stock_movements")
}

enum AdjustmentType {
  INCREASE
  DECREASE
}

model StockAdjustment {
  id          String         @id @default(uuid())
  productId   String
  warehouseId String
  type        AdjustmentType
  quantity    Decimal        @db.Decimal(14, 3)
  reason      String
  notes       String?
  createdById String
  createdAt   DateTime       @default(now())

  product     Product   @relation(fields: [productId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  createdBy   User      @relation("StockAdjustmentCreatedBy", fields: [createdById], references: [id])

  @@index([productId])
  @@index([warehouseId])
  @@map("stock_adjustments")
}

// ==========================================================================
// PRODUCTION (raw materials -> finished product)
// ==========================================================================

enum ProductionStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

// A production run: consumes ProductionMaterial rows (raw materials, from an existing Product)
// out of sourceWarehouse and, once completed, yields plannedQuantity/actualQuantity units of
// finishedProduct (also an existing Product - never a separate "finished goods" model) into
// destinationWarehouse. Stays DRAFT (no stock touched) until completed, mirroring how a
// Purchase stays PENDING until received - reuses that same two-step shape rather than a new one.
model Production {
  id                      String           @id @default(uuid())
  productionNumber        String           @unique
  finishedProductId       String
  plannedQuantity         Decimal          @db.Decimal(14, 3)
  actualQuantity          Decimal?         @db.Decimal(14, 3)
  sourceWarehouseId       String
  destinationWarehouseId  String
  status                  ProductionStatus @default(DRAFT)
  unitCost                Decimal?         @db.Decimal(14, 4)
  totalCost               Decimal?         @db.Decimal(14, 2)
  batchNumber             String?
  notes                   String?
  createdById             String
  completedAt             DateTime?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  finishedProduct         Product   @relation("ProductionOutput", fields: [finishedProductId], references: [id])
  sourceWarehouse         Warehouse @relation("ProductionSource", fields: [sourceWarehouseId], references: [id])
  destinationWarehouse    Warehouse @relation("ProductionDestination", fields: [destinationWarehouseId], references: [id])
  createdBy               User      @relation("ProductionCreatedBy", fields: [createdById], references: [id])
  materials                ProductionMaterial[]

  @@index([finishedProductId])
  @@index([status])
  @@index([createdAt])
  @@map("productions")
}

model ProductionMaterial {
  id            String  @id @default(uuid())
  productionId  String
  productId     String
  // Which warehouse THIS material is actually consumed from - independent of the parent
  // Production's sourceWarehouseId, so a single run can pull Flour from Main Kitchen Store and
  // Sugar from Cold Room in one go. Nullable so an old row created before this field existed
  // simply means "use Production.sourceWarehouseId" (see production.service.ts) - never
  // backfilled or guessed at.
  warehouseId   String?
  quantity      Decimal @db.Decimal(14, 3)
  unitCost      Decimal @db.Decimal(14, 4)
  total         Decimal @db.Decimal(14, 2)

  production    Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  product       Product    @relation("ProductionMaterialProduct", fields: [productId], references: [id])
  warehouse     Warehouse? @relation(fields: [warehouseId], references: [id])

  @@index([productionId])
  @@index([productId])
  @@index([warehouseId])
  @@map("production_materials")
}

// ==========================================================================
// SUPPLIERS / PURCHASES
// ==========================================================================

model Supplier {
  id            String     @id @default(uuid())
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  purchases     Purchase[]

  @@map("suppliers")
}

enum PurchaseStatus {
  DRAFT
  PENDING
  RECEIVED
  PARTIALLY_RECEIVED
  CANCELLED
}

model Purchase {
  id             String         @id @default(uuid())
  purchaseNumber String         @unique
  supplierId     String
  warehouseId    String
  invoiceNumber  String?
  purchaseDate   DateTime       @default(now())
  status         PurchaseStatus @default(DRAFT)
  subtotal       Decimal        @default(0) @db.Decimal(14, 2)
  tax            Decimal        @default(0) @db.Decimal(14, 2)
  discount       Decimal        @default(0) @db.Decimal(14, 2)
  total          Decimal        @default(0) @db.Decimal(14, 2)
  notes          String?
  createdById    String
  receivedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  supplier       Supplier       @relation(fields: [supplierId], references: [id])
  warehouse      Warehouse      @relation(fields: [warehouseId], references: [id])
  createdBy      User           @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  items          PurchaseItem[]

  @@index([supplierId])
  @@index([warehouseId])
  @@index([status])
  @@map("purchases")
}

model PurchaseItem {
  id             String   @id @default(uuid())
  purchaseId     String
  productId      String
  quantity       Decimal  @db.Decimal(14, 3)
  receivedQty    Decimal  @default(0) @db.Decimal(14, 3)
  unitCost       Decimal  @db.Decimal(14, 4)
  total          Decimal  @db.Decimal(14, 2)
  // Optional supplier lot label, carried onto the InventoryBatch created when this item is
  // received. Expiry is NOT entered here - it's computed at receiving time from the product's
  // shelf life, since the same purchase item can be part-received on different actual dates.
  batchNumber    String?
  createdAt      DateTime @default(now())

  purchase       Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product        Product  @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

// ==========================================================================
// WASTAGE
// ==========================================================================

enum WastageReason {
  EXPIRED
  DAMAGED
  SPOILED
  BURNED
  SPILLED
  OTHER
}

enum WastageStatus {
  PENDING
  APPROVED
  REJECTED
}

model Wastage {
  id           String        @id @default(uuid())
  wastageNumber String       @unique
  warehouseId  String
  reason       WastageReason
  status       WastageStatus @default(PENDING)
  description  String?
  createdById  String
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  warehouse    Warehouse     @relation(fields: [warehouseId], references: [id])
  createdBy    User          @relation("WastageCreatedBy", fields: [createdById], references: [id])
  approvedBy   User?         @relation("WastageApprovedBy", fields: [approvedById], references: [id])
  items        WastageItem[]

  @@index([warehouseId])
  @@index([status])
  @@map("wastages")
}

model WastageItem {
  id         String  @id @default(uuid())
  wastageId  String
  productId  String
  quantity   Decimal @db.Decimal(14, 3)
  unitCost   Decimal @default(0) @db.Decimal(14, 4)

  wastage    Wastage @relation(fields: [wastageId], references: [id], onDelete: Cascade)
  product    Product @relation(fields: [productId], references: [id])

  @@index([wastageId])
  @@index([productId])
  @@map("wastage_items")
}

// ==========================================================================
// RECIPES / MENU / SALES
// ==========================================================================

model Recipe {
  id                 String             @id @default(uuid())
  name               String
  description        String?
  menuItemId         String?            @unique
  // Optional link to the Product it produces (e.g. "Mandazi") so a Production run can load its
  // ingredient list instead of the user rebuilding it by hand every time. Independent of
  // menuItemId - a recipe can be linked to a menu item, a finished product, both, or neither
  // (an unlinked, reusable recipe), mirroring how menuItemId already works.
  finishedProductId  String?            @unique
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  menuItem           MenuItem?          @relation(fields: [menuItemId], references: [id])
  finishedProduct    Product?           @relation("ProductFinishedRecipe", fields: [finishedProductId], references: [id])
  ingredients        RecipeIngredient[]

  @@map("recipes")
}

model RecipeIngredient {
  id        String  @id @default(uuid())
  recipeId  String
  productId String
  quantity  Decimal @db.Decimal(14, 3) // quantity of product's unit per 1 unit of whatever the parent Recipe is linked to (1 menu item sold, or 1 unit of the linked finished product produced)

  recipe    Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@unique([recipeId, productId])
  @@map("recipe_ingredients")
}

model MenuItem {
  id              String    @id @default(uuid())
  name            String
  description     String?
  price           Decimal   @db.Decimal(14, 2)
  category        String?
  isActive        Boolean   @default(true)
  imageUrl        String?
  // Set only for a menu item created via "List for Sale" (see menuItem.service.ts
  // ensureSellableMenuItem): marks this item as THE resale listing for that Product, so
  // producing/reclassifying the same product again reuses it instead of creating a duplicate
  // menu entry with the ingredients rebuilt from scratch. Ordinary menu items (a cooked dish with
  // its own recipe) leave this null - unrelated to Recipe.menuItemId, which is the recipe a menu
  // item consumes when sold, not the product it resells.
  linkedProductId String?   @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  linkedProduct   Product?   @relation("ProductDirectSaleMenuItem", fields: [linkedProductId], references: [id])
  recipe          Recipe?
  saleItems       SaleItem[]

  @@map("menu_items")
}

enum SaleStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_MONEY
  BANK_TRANSFER
  OTHER
}

enum SaleSource {
  POS
  ONLINE
}

model Sale {
  id            String        @id @default(uuid())
  saleNumber    String        @unique
  warehouseId   String
  subtotal      Decimal       @default(0) @db.Decimal(14, 2)
  discount      Decimal       @default(0) @db.Decimal(14, 2)
  tax           Decimal       @default(0) @db.Decimal(14, 2)
  total         Decimal       @default(0) @db.Decimal(14, 2)
  paymentMethod PaymentMethod @default(CASH)
  status        SaleStatus    @default(COMPLETED)
  source        SaleSource    @default(POS)
  customerName  String?
  customerId    String?
  createdById   String
  // Who accepted/confirmed the order (moved it to COMPLETED) and when - a POS sale is
  // considered self-confirmed by its creator at creation time; an online order is confirmed
  // separately, later, by whichever staff/manager/admin fulfills it.
  confirmedById String?
  confirmedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id])
  createdBy     User          @relation("SaleCreatedBy", fields: [createdById], references: [id])
  confirmedBy   User?         @relation("SaleConfirmedBy", fields: [confirmedById], references: [id])
  customer      User?         @relation("SaleCustomer", fields: [customerId], references: [id])
  items         SaleItem[]

  @@index([warehouseId])
  @@index([status])
  @@index([createdAt])
  @@index([customerId])
  @@map("sales")
}

model SaleItem {
  id         String  @id @default(uuid())
  saleId     String
  menuItemId String
  quantity   Int
  unitPrice  Decimal @db.Decimal(14, 2)
  total      Decimal @db.Decimal(14, 2)

  sale       Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([saleId])
  @@index([menuItemId])
  @@map("sale_items")
}

// ==========================================================================
// AUDIT / NOTIFICATIONS
// ==========================================================================

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

enum NotificationType {
  LOW_STOCK
  EXPIRY_WARNING
  PURCHASE_RECEIVED
  WASTAGE_PENDING_APPROVAL
  SYSTEM
}

model Notification {
  id        String            @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean           @default(false)
  metadata  Json?
  createdAt DateTime          @default(now())

  user      User              @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

// ==========================================================================
// EXPENSES
// ==========================================================================

enum ExpenseCategory {
  SALARY
  ELECTRICITY
  WATER
  RENT
  TAX
  TRANSPORT
  MAINTENANCE
  INTERNET
  MARKETING
  OTHER
}

enum ExpenseStatus {
  PAID
}

// Created and paid in one step by an authorized Admin/Manager - there is no separate approval
// stage, so `createdBy` doubles as "paid by". For SALARY, the recipient is an existing
// STAFF/MANAGER user account (never a new/duplicate worker record); for every other category,
// `recipientName` is a free-text payee (utility company, landlord, vendor, etc.).
model Expense {
  id              String          @id @default(uuid())
  expenseNumber   String          @unique
  category        ExpenseCategory
  recipientUserId String?
  recipientName   String?
  amount          Decimal         @db.Decimal(14, 2)
  status          ExpenseStatus   @default(PAID)
  description     String?
  createdById     String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  recipientUser   User?           @relation("ExpenseRecipient", fields: [recipientUserId], references: [id])
  createdBy       User            @relation("ExpenseCreatedBy", fields: [createdById], references: [id])

  @@index([category])
  @@index([createdAt])
  @@index([recipientUserId])
  @@map("expenses")
}
