# Dependencies
node_modules/
**/node_modules/

# Build output
dist/
**/dist/
dist-ssr/
build/

# Environment variables and secrets (matched at any depth - the safety net beyond backend/.env)
.env
.env.*
!.env.example
!**/.env.example
**/.env
**/.env.*
!**/.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test / coverage
coverage/
**/coverage/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Prisma
backend/prisma/*.db

# TypeScript incremental build cache
*.tsbuildinfo

# Vercel CLI project link (created locally by `vercel link` - project/org IDs, not shared config)
.vercel

# Misc local files
*.local
